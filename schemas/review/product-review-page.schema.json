    "CatalogStamp": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string",
          "x-maxUtf8Bytes": 256
        },
        "encoding": {
          "enum": [
            "utf-8",
            "utf-8-sig",
            "utf-16",
            "cp1252",
            "latin-1"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "record_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "row_count_complete": {
          "default": true,
          "title": "Row Count Complete",
          "type": "boolean"
        },
        "source_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "source_sha256",
        "encoding",
        "record_count"
      ],
      "title": "CatalogStamp",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "output_truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Truncated"
        },
        "profile_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requested": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested"
        },
        "returned": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "FieldCheck": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "enum": [
            "id",
            "name",
            "brand",
            "size",
            "unit",
            "price",
            "category",
            "description"
          ],
          "title": "Field Id",
          "type": "string"
        },
        "issue_code": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Issue Code"
        },
        "pointer": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProductPointer"
            },
            {
              "type": "null"
            }
          ]
        },
        "record": {
          "$ref": "#/$defs/RecordRef"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resolution"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record",
        "field_id",
        "pointer",
        "resolution",
        "issue_code"
      ],
      "title": "FieldCheck",
      "type": "object"
    },
    "JudgmentProposal": {
      "additionalProperties": false,
      "description": "Raw signals plus explicit calibration provenance, never a human event.",
      "properties": {
        "calibration": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "issue_codes": {
          "default": [],
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Issue Codes",
          "type": "array"
        },
        "kind": {
          "const": "judgment_proposal",
          "default": "judgment_proposal",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "enum": [
            "fuzzy",
            "rules",
            "jev",
            "llm"
          ],
          "title": "Method",
          "type": "string"
        },
        "native_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Confidence"
        },
        "native_probabilities": {
          "anyOf": [
            {
              "items": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "maxItems": 10,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Probabilities"
        },
        "p_same": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Same"
        },
        "relatedness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relatedness"
        },
        "schema_version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "invalid",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "method",
        "status"
      ],
      "title": "JudgmentProposal",
      "type": "object"
    },
    "PairIdentity": {
      "additionalProperties": false,
      "properties": {
        "pair_generation": {
          "maxLength": 68,
          "minLength": 68,
          "pattern": "^pg1:[0-9a-f]{64}$",
          "title": "Pair Generation",
          "type": "string"
        },
        "pair_key": {
          "maxLength": 68,
          "minLength": 68,
          "pattern": "^pk1:[0-9a-f]{64}$",
          "title": "Pair Key",
          "type": "string"
        },
        "raw_fingerprints": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          ],
          "title": "Raw Fingerprints",
          "type": "array"
        },
        "refs": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/RecordIdentity"
            },
            {
              "$ref": "#/$defs/RecordIdentity"
            }
          ],
          "title": "Refs",
          "type": "array"
        },
        "schema_version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "refs",
        "raw_fingerprints",
        "pair_key",
        "pair_generation"
      ],
      "title": "PairIdentity",
      "type": "object"
    },
    "ProductLocator": {
      "additionalProperties": false,
