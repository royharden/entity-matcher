{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Logical reference only; no file opener or URL authority.",
      "properties": {
        "artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_sha256",
        "profile_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CalibrationEvidence": {
      "additionalProperties": false,
      "properties": {
        "config_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "dev_manifest_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dev Manifest Sha256",
          "type": "string"
        },
        "support_count": {
          "minimum": 1,
          "title": "Support Count",
          "type": "integer"
        }
      },
      "required": [
        "dev_manifest_sha256",
        "config_sha256",
        "support_count"
      ],
      "title": "CalibrationEvidence",
      "type": "object"
    },
    "CandidateOverview": {
      "additionalProperties": false,
      "properties": {
        "b1_enumerated_unique": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "B1 Enumerated Unique",
          "type": "integer"
        },
        "b2_enumerated_unique": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "B2 Enumerated Unique",
          "type": "integer"
        },
        "block_omission_count": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Block Omission Count",
          "type": "integer"
        },
        "global_cap": {
          "maximum": 500000,
          "minimum": 1,
          "title": "Global Cap",
          "type": "integer"
        },
        "global_cap_drops": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Global Cap Drops",
          "type": "integer"
        },
        "n_a": {
          "maximum": 10000,
          "minimum": 0,
          "title": "N A",
          "type": "integer"
        },
        "n_b": {
          "maximum": 10000,
          "minimum": 0,
          "title": "N B",
          "type": "integer"
        },
        "per_a_cap": {
          "maximum": 50,
          "minimum": 1,
          "title": "Per A Cap",
          "type": "integer"
        },
        "per_a_cap_drops": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Per A Cap Drops",
          "type": "integer"
        },
        "possible_pairs": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Possible Pairs",
          "type": "integer"
        },
        "profile": {
          "const": "product-candidates-v1",
          "title": "Profile",
          "type": "string"
        },
        "retained": {
          "maximum": 500000,
          "minimum": 0,
          "title": "Retained",
          "type": "integer"
        },
        "token_keys_truncated_records": {
          "maximum": 20000,
          "minimum": 0,
          "title": "Token Keys Truncated Records",
          "type": "integer"
        },
        "uncapped_union_exact": {
          "title": "Uncapped Union Exact",
          "type": "boolean"
        },
        "uncapped_union_lower_bound": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Uncapped Union Lower Bound",
          "type": "integer"
        },
        "uncapped_union_upper_bound": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Uncapped Union Upper Bound",
          "type": "integer"
        },
        "union_enumerated_unique": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Union Enumerated Unique",
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "n_a",
        "n_b",
        "possible_pairs",
        "b1_enumerated_unique",
        "b2_enumerated_unique",
        "union_enumerated_unique",
        "uncapped_union_lower_bound",
        "uncapped_union_upper_bound",
        "uncapped_union_exact",
        "retained",
        "per_a_cap_drops",
