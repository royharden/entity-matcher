          "type": "string"
        },
        "quote": {
          "maxLength": 32768,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
