{
  "$defs": {
    "CalibrationEvidence": {
      "additionalProperties": false,
      "properties": {
        "config_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "dev_manifest_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dev Manifest Sha256",
          "type": "string"
        },
        "support_count": {
          "minimum": 1,
          "title": "Support Count",
          "type": "integer"
        }
      },
      "required": [
        "dev_manifest_sha256",
        "config_sha256",
        "support_count"
      ],
      "title": "CalibrationEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Raw signals plus explicit calibration provenance, never a human event.",
  "properties": {
    "calibration": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalibrationEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "issue_codes": {
      "default": [],
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Issue Codes",
      "type": "array"
    },
    "kind": {
      "const": "judgment_proposal",
      "default": "judgment_proposal",
      "title": "Kind",
      "type": "string"
    },
    "method": {
      "enum": [
        "fuzzy",
        "rules",
        "jev",
        "llm"
      ],
      "title": "Method",
      "type": "string"
    },
    "native_confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Confidence"
    },
    "native_probabilities": {
      "anyOf": [
        {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 10,
          "minItems": 2,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Probabilities"
    },
    "p_same": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "P Same"
    },
    "relatedness": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relatedness"
    },
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "ok",
        "unavailable",
        "invalid",
        "error"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "method",
    "status"
  ],
  "title": "JudgmentProposal",
  "type": "object"
}
